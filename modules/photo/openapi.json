{
  "openapi": "3.1.0",
  "info": {
    "title": "TenukiGo-2025 Photo Completion Module API",
    "summary": "TenukiGo OpenAPI Specifications",
    "description": "Module dedicated to photo analysis and move completion for the TenukiGo platform.",
    "version": "1.0"
  },
  "paths": {
    "/model/load": {
      "post": {
        "tags": [
          "Model Management"
        ],
        "summary": "Load Model",
        "description": "Load an AI model.\n\nExpected JSON:\n{\n    \"model_path\": \"/path/to/model.keras\",  // Optional, loads legacy if not provided\n    \"use_legacy\": true                     // Optional, default true\n}",
        "operationId": "load_model_model_load_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelLoadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/model/info": {
      "get": {
        "tags": [
          "Model Management"
        ],
        "summary": "Model Info",
        "description": "Get information about the currently loaded model.",
        "operationId": "model_info_model_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/model/unload": {
      "post": {
        "tags": [
          "Model Management"
        ],
        "summary": "Unload Model",
        "description": "Unload the current AI model.",
        "operationId": "unload_model_model_unload_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/model/load_yolo": {
      "post": {
        "tags": [
          "Model Management"
        ],
        "summary": "Load Yolo Model",
        "description": "Load YOLO model for image processing.\n\nExpected JSON:\n{\n    \"model_path\": \"/path/to/model.pt\"\n}",
        "operationId": "load_yolo_model_model_load_yolo_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/YoloLoadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/photo": {
      "post": {
        "tags": [
          "Photo Management"
        ],
        "summary": "Process Two Photos Legacy",
        "description": "Legacy endpoint for frontend compatibility - processes two photos.",
        "operationId": "process_two_photos_legacy_photo_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_process_two_photos_legacy_photo_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/photo/upload": {
      "post": {
        "tags": [
          "Photo Management"
        ],
        "summary": "Upload Photo",
        "description": "Upload and process a photo to extract board state.\n\nForm data:\n- file: Image file\n- metadata: Optional JSON metadata for SGF generation",
        "operationId": "upload_photo_photo_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_photo_photo_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/photo/process_two": {
      "post": {
        "tags": [
          "Photo Management"
        ],
        "summary": "Process Two Photos",
        "description": "Process two photos and generate SGF with predicted moves between them.",
        "operationId": "process_two_photos_photo_process_two_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_process_two_photos_photo_process_two_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/complete": {
      "post": {
        "tags": [
          "Move Completion between Photos"
        ],
        "summary": "Complete Moves",
        "description": "Complete moves between two board states.\n\nExpected JSON:\n{\n    \"initial_state\": [[0,0,...], [1,2,...]],  // 2D array representing board\n    \"final_state\": [[0,0,...], [1,2,...]],   // 2D array representing board\n    \"board_size\": 19,                         // Optional, default 19\n    \"use_ai\": false                           // Optional, default false\n}",
        "operationId": "complete_moves_complete_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteMovesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "tags": [
          "Analysis between Photos"
        ],
        "summary": "Analyze Position",
        "description": "Analyze differences between two board states without completing moves.\n\nExpected JSON:\n{\n    \"initial_state\": [[0,0,...], [1,2,...]],  // 2D array representing board\n    \"final_state\": [[0,0,...], [1,2,...]],   // 2D array representing board\n    \"board_size\": 19                          // Optional, default 19\n}",
        "operationId": "analyze_position_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "initial_state": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Initial State"
          },
          "final_state": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Final State"
          },
          "board_size": {
            "type": "integer",
            "title": "Board Size",
            "default": 19
          }
        },
        "type": "object",
        "required": [
          "initial_state",
          "final_state"
        ],
        "title": "AnalyzeRequest"
      },
      "Body_process_two_photos_legacy_photo_post": {
        "properties": {
          "image1": {
            "type": "string",
            "format": "binary",
            "title": "Image1"
          },
          "image2": {
            "type": "string",
            "format": "binary",
            "title": "Image2"
          },
          "use_ai": {
            "type": "string",
            "title": "Use Ai",
            "default": "false"
          },
          "metadata": {
            "type": "string",
            "title": "Metadata",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "image1",
          "image2"
        ],
        "title": "Body_process_two_photos_legacy_photo_post"
      },
      "Body_process_two_photos_photo_process_two_post": {
        "properties": {
          "file1": {
            "type": "string",
            "format": "binary",
            "title": "File1"
          },
          "file2": {
            "type": "string",
            "format": "binary",
            "title": "File2"
          },
          "use_ai": {
            "type": "string",
            "title": "Use Ai",
            "default": "false"
          },
          "metadata": {
            "type": "string",
            "title": "Metadata",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "file1",
          "file2"
        ],
        "title": "Body_process_two_photos_photo_process_two_post"
      },
      "Body_upload_photo_photo_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "metadata": {
            "type": "string",
            "title": "Metadata",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_photo_photo_upload_post"
      },
      "CompleteMovesRequest": {
        "properties": {
          "initial_state": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Initial State"
          },
          "final_state": {
            "items": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Final State"
          },
          "board_size": {
            "type": "integer",
            "title": "Board Size",
            "default": 19
          },
          "use_ai": {
            "type": "boolean",
            "title": "Use Ai",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "initial_state",
          "final_state"
        ],
        "title": "CompleteMovesRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelLoadRequest": {
        "properties": {
          "model_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Path"
          },
          "use_legacy": {
            "type": "boolean",
            "title": "Use Legacy",
            "default": true
          }
        },
        "type": "object",
        "title": "ModelLoadRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "YoloLoadRequest": {
        "properties": {
          "model_path": {
            "type": "string",
            "title": "Model Path"
          }
        },
        "type": "object",
        "required": [
          "model_path"
        ],
        "title": "YoloLoadRequest"
      }
    }
  }
}